{
  "id": "transcription",
  "name": "Call Transcription",
  "version": "0.5.0",
  "description": "Live transcripts of your calls, using a Whisper server you host yourself.",
  "main": "main.js",
  "audio": true,
  "actions": [
    {
      "id": "open",
      "label": "Call Transcripts"
    }
  ],
  "settings": [
    {
      "key": "server",
      "type": "text",
      "label": "Speech-to-text server",
      "default": "http://127.0.0.1:8787",
      "placeholder": "http://host:port",
      "help": "Address and port of the server that runs the Whisper model."
    },
    {
      "key": "endpoint",
      "type": "text",
      "label": "Endpoint",
      "default": "/transcribe"
    },
    {
      "key": "api",
      "type": "select",
      "label": "How the server takes audio",
      "default": "raw",
      "options": [
        {
          "value": "raw",
          "label": "WAV file as the request body, answers {\"text\": \u2026}"
        },
        {
          "value": "openai",
          "label": "OpenAI style (/v1/audio/transcriptions, file upload)"
        }
      ]
    },
    {
      "key": "model",
      "type": "text",
      "label": "Model name (OpenAI style only)",
      "default": "whisper-1",
      "showIf": {
        "api": "openai"
      }
    },
    {
      "key": "authHeader",
      "type": "text",
      "label": "Secret header name (blank if the server needs none)",
      "default": "x-local-secret"
    },
    {
      "key": "authValue",
      "type": "password",
      "label": "Secret",
      "default": "",
      "help": "Kept in this computer's Sangoma Phone profile."
    },
    {
      "key": "language",
      "type": "text",
      "label": "Language (OpenAI style only; blank = detect)",
      "default": "en",
      "showIf": {
        "api": "openai"
      }
    },
    {
      "key": "fallbackEnabled",
      "type": "boolean",
      "label": "Use a second server when the first can't be reached",
      "default": false,
      "help": "The first server is tried again every 30 seconds."
    },
    {
      "key": "fallbackServer",
      "type": "text",
      "label": "Second server",
      "default": "http://127.0.0.1:8787",
      "placeholder": "http://host:port",
      "showIf": {
        "fallbackEnabled": true
      }
    },
    {
      "key": "fallbackEndpoint",
      "type": "text",
      "label": "Second server: endpoint",
      "default": "/transcribe",
      "showIf": {
        "fallbackEnabled": true
      }
    },
    {
      "key": "fallbackApi",
      "type": "select",
      "label": "Second server: how it takes audio",
      "default": "raw",
      "options": [
        {
          "value": "raw",
          "label": "WAV file as the request body, answers {\"text\": \u2026}"
        },
        {
          "value": "openai",
          "label": "OpenAI style (/v1/audio/transcriptions, file upload)"
        }
      ],
      "showIf": {
        "fallbackEnabled": true
      }
    },
    {
      "key": "fallbackModel",
      "type": "text",
      "label": "Second server: model name (OpenAI style only)",
      "default": "whisper-1",
      "showIf": {
        "fallbackEnabled": true
      }
    },
    {
      "key": "fallbackAuthHeader",
      "type": "text",
      "label": "Second server: secret header name",
      "default": "x-local-secret",
      "showIf": {
        "fallbackEnabled": true
      }
    },
    {
      "key": "fallbackAuthValue",
      "type": "password",
      "label": "Second server: secret",
      "default": "",
      "showIf": {
        "fallbackEnabled": true
      }
    },
    {
      "key": "openOnCall",
      "type": "boolean",
      "label": "Switch to Transcripts when a call starts",
      "default": false,
      "help": "Off: the call screen stays in front; open Transcripts from the top bar when you want to read along."
    },
    {
      "key": "saveLocally",
      "type": "boolean",
      "label": "Save transcripts on this computer",
      "default": false,
      "help": "Off: transcripts are kept in memory and are gone when Sangoma Phone closes."
    },
    {
      "key": "folder",
      "type": "folder",
      "label": "Folder for saved transcripts",
      "default": "",
      "showIf": {
        "saveLocally": true
      }
    },
    {
      "key": "memoryPercent",
      "type": "percent",
      "of": "memory",
      "label": "Memory transcripts may use",
      "default": 2,
      "min": 1,
      "max": 85,
      "showIf": {
        "saveLocally": false
      },
      "help": "When this is full, the oldest conversations are dropped to make room."
    }
  ]
}
